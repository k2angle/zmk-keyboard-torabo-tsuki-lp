#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <28 29>;
            layers = <2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&trans  &trans     &trans    &trans    &trans       &trans                                                 &trans       &trans  &trans     &trans    &trans      &trans
&trans  &kp Q      &kp W     &kp E     &kp R        &kp T                                                  &kp Y        &kp U   &kp I      &kp O     &kp P       &trans
&trans  &kp A      &kp S     &kp D     &kp F        &kp G        &trans                     &trans         &kp H        &kp J   &lt 3 K    &lt 1 L   &kp MINUS   &trans
&trans  &kp Z      &kp X     &kp C     &kp V        &kp B        &msc SCRL_DOWN             &msc SCRL_UP   &kp N        &kp M   &kp COMMA  &kp DOT   &kp SLASH   &trans
&trans  &kp LCTRL  &kp LGUI  &kp LALT  &lt 3 LANG2  &lt 1 SPACE  &mt LEFT_SHIFT LANGUAGE_1  &kp BACKSPACE  &lt 2 ENTER  &trans  &trans     &kp RGUI  &kp ESCAPE  &trans
            >;
        };

        layer_1 {
            bindings = <
&trans  &trans           &trans       &trans         &trans                &trans                                                &trans                    &trans     &trans         &trans         &trans             &trans
&trans  &kp EXCLAMATION  &kp AT_SIGN  &kp HASH       &kp LEFT_BRACE        &kp RIGHT_BRACE                                       &kp RC(RG(RS(NUMBER_4)))  &kp F7     &kp F10        &kp SQT        &kp DOUBLE_QUOTES  &trans
&trans  &kp DOLLAR       &kp PERCENT  &kp AMPERSAND  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &trans  &trans                 &kp RG(R)                 &mkp MB1   &mkp MB2       &kp SEMICOLON  &kp COLON          &trans
&trans  &kp LCTRL        &trans       &trans         &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans  &trans                 &kp RG(C)                 &kp RG(V)  &kp RA(RG(V))  &kp TILDE      &kp GRAVE          &trans
&trans  &trans           &trans       &trans         &trans                &trans                 &trans  &kp RG(RIGHT_BRACKET)  &kp RG(LEFT_BRACKET)      &trans     &trans         &trans         &trans             &trans
            >;
        };

        layer_2 {
            bindings = <
&trans  &trans                &trans           &trans           &trans           &trans                              &trans              &trans               &trans          &trans             &trans           &trans
&trans  &kp LS(BACKSPACE)     &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_DOT                          &kp LS(PAGE_UP)     &kp HOME             &kp UP_ARROW    &kp END            &kp DEL          &trans
&trans  &kp NON_US_BACKSLASH  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_PLUS   &trans        &trans  &kp PAGE_DOWN       &kp LEFT_ARROW       &kp DOWN_ARROW  &kp RIGHT_ARROW    &kp K_MUTE       &trans
&trans  &kp KP_NUMBER_0       &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_MINUS  &trans        &trans  &kp RA(LEFT_ARROW)  &kp RA(RIGHT_ARROW)  &trans          &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &trans
&trans  &trans                &trans           &trans           &kp KP_ASTERISK  &kp KP_SLASH  &kp KP_EQUAL  &trans  &trans              &trans               &trans          &trans             &trans           &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans      &trans      &trans        &trans        &trans                      &trans            &trans     &trans         &trans     &trans      &trans
&trans  &bt BT_NXT  &bt BT_PRV  &trans        &trans        &trans                     &trans          &trans  &trans  &trans    &trans  &trans
&trans  &trans      &trans      &trans        &trans       &trans     &trans  &trans &trans         &trans   &trans   &trans  &trans    &trans
&trans  &trans    &trans     &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans      &trans  &trans    &trans
&trans  &trans      &trans      &trans        &trans    &trans     &trans  &trans  &trans            &trans     &trans         &trans     &trans      &trans
            >;
        };
    };
};
