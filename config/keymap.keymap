#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        studio_unlock {
            bindings = <&studio_unlock>;
            key-positions = <44 45>;
        };

        esc {
            bindings = <&kp ESCAPE>;
            key-positions = <63 64>;
        };

        click1 {
            bindings = <&mkp MB1>;
            key-positions = <33 34>;
        };

        click2 {
            bindings = <&mkp MB2>;
            key-positions = <35 36>;
        };

        lang2 {
            bindings = <&kp LANG2>;
            key-positions = <28 27>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&trans  &trans     &trans    &trans    &trans       &trans                                                 &trans       &trans  &trans     &trans   &trans     &trans
&trans  &kp Q      &kp W     &kp E     &kp R        &kp T                                                  &kp Y        &kp U   &kp I      &kp O    &kp P      &trans
&trans  &kp A      &kp S     &kp D     &kp F        &kp G        &trans                     &trans         &kp H        &kp J   &lt 3 K    &lt 1 L  &kp MINUS  &trans
&trans  &kp Z      &kp X     &kp C     &kp V        &kp B        &msc SCRL_DOWN             &msc SCRL_UP   &kp N        &kp M   &kp COMMA  &kp DOT  &kp SLASH  &trans
&trans  &kp LCTRL  &kp LGUI  &kp LALT  &lt 3 LANG2  &lt 1 SPACE  &mt LEFT_SHIFT LANGUAGE_1  &kp BACKSPACE  &lt 2 ENTER  &trans  &trans     &kp F7   &kp F10    &trans
            >;
        };

        layer_1 {
            bindings = <
&trans  &trans           &trans       &trans         &trans                &trans                                                &trans                    &trans              &trans               &trans         &trans             &trans
&trans  &kp EXCLAMATION  &kp AT_SIGN  &kp HASH       &kp LEFT_BRACE        &kp RIGHT_BRACE                                       &kp RC(RG(RS(NUMBER_4)))  &kp RC(LEFT_ARROW)  &kp RC(RIGHT_ARROW)  &kp SQT        &kp DOUBLE_QUOTES  &trans
&trans  &kp DOLLAR       &kp PERCENT  &kp AMPERSAND  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &trans  &trans                 &kp RG(R)                 &mkp MB1            &mkp MB2             &kp SEMICOLON  &kp COLON          &trans
&trans  &kp LCTRL        &trans       &trans         &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans  &kp RG(W)              &kp RG(C)                 &kp RG(V)           &kp RA(RG(V))        &kp TILDE      &kp GRAVE          &trans
&trans  &trans           &trans       &trans         &trans                &trans                 &trans  &kp RG(RIGHT_BRACKET)  &kp RG(LEFT_BRACKET)      &trans              &trans               &trans         &trans             &trans
            >;
        };

        layer_2 {
            bindings = <
&trans  &trans                &trans           &trans           &trans           &trans                              &trans            &trans              &trans               &trans             &trans           &trans
&trans  &kp BACKSPACE         &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_DOT                          &kp RC(UP_ARROW)  &kp RS(P)           &kp UP_ARROW         &kp RS(N)          &kp K_MUTE       &trans
&trans  &kp NON_US_BACKSLASH  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_PLUS   &trans        &trans  &msc SCRL_UP      &kp LEFT_ARROW      &kp DOWN_ARROW       &kp RIGHT_ARROW    &kp DELETE       &trans
&trans  &kp KP_NUMBER_0       &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_MINUS  &trans        &trans  &msc SCRL_DOWN    &kp RA(LEFT_ARROW)  &kp RA(RIGHT_ARROW)  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &trans
&trans  &trans                &trans           &trans           &kp KP_ASTERISK  &kp KP_SLASH  &kp KP_EQUAL  &trans  &trans            &trans              &trans               &trans             &trans           &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans     &trans     &trans  &trans          &trans                  &trans        &trans        &trans        &trans        &trans      &trans
&trans  &trans     &trans     &trans  &msc SCRL_UP    &trans                  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &trans      &trans
&trans  &trans     &kp LG(S)  &trans  &msc SCRL_DOWN  &trans  &trans  &trans  &bt BT_PRV    &bt BT_NXT    &trans        &trans        &trans      &trans
&trans  &kp LG(Z)  &trans     &trans  &trans          &trans  &trans  &trans  &trans        &trans        &trans        &trans        &trans      &trans
&trans  &trans     &trans     &trans  &trans          &trans  &trans  &trans  &trans        &trans        &trans        &trans        &bt BT_CLR  &trans
            >;
        };
    };
};
